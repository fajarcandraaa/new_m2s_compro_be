# ---------------------------------------------------------------------------
# Mind2Screen backend configuration. Copy to .env and change every secret.
# docker compose reads .env automatically; for a local run without Docker,
# export these variables (e.g. `set -a; . ./.env; set +a`).
# ---------------------------------------------------------------------------

# --- docker compose only (postgres service) ---
POSTGRES_DB=m2s
POSTGRES_USER=m2s
POSTGRES_PASSWORD=change-me-postgres-password

# --- backend ---
PORT=8080
# Required. Ignored by docker compose (built from POSTGRES_* there).
DATABASE_URL=postgres://postgres:secret@localhost:5433/new_compro?sslmode=disable
MIGRATE_ON_START=true
SEED_ON_START=true
# Required, at least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_TTL=12h
# true in production (HTTPS); false for plain-http local runs.
COOKIE_SECURE=false
# Initial admin, created only when the users table is empty.
# Password: 10-64 characters (max 72 bytes).
ADMIN_EMAIL=admin@mindtoscreen.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Admin
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=2097152
# Base URL the BE uses to call the FE revalidation route.
FRONTEND_URL=http://localhost:3000
# Shared with the FE; empty disables revalidation.
REVALIDATE_SECRET=change-me-revalidate-secret
# Position of the client IP from the right of X-Forwarded-For.
TRUSTED_PROXY_HOPS=1
# debug | info | warn | error
LOG_LEVEL=info

# --- frontend (docker compose fe service) ---
SITE_URL=http://localhost:3000
